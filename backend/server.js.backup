/*
==================================================
EDIT PRODUCT
TODAY ONLY
==================================================
*/

app.put(
    "/api/products/:id",
    async (req, res) => {

        try {

            const {
                name,
                price,
                remainingQuantity,
                newOrderQuantity
            } = req.body;


            const productName =
                typeof name === "string"
                    ? name.trim()
                    : "";

            const numericPrice =
                Number(price);

            const numericRemaining =
                Number(remainingQuantity);

            const numericNewOrder =
                Number(newOrderQuantity);


            /*
            ------------------------------------------
            VALIDATION
            ------------------------------------------
            */

            if (!productName) {

                return res.status(400).json({
                    success: false,
                    message: "Product name is required"
                });

            }


            if (
                !Number.isFinite(numericPrice) ||
                numericPrice < 0
            ) {

                return res.status(400).json({
                    success: false,
                    message:
                        "Price must be a valid non-negative number"
                });

            }


            if (
                !Number.isFinite(numericRemaining) ||
                numericRemaining < 0
            ) {

                return res.status(400).json({
                    success: false,
                    message:
                        "Remaining quantity must be a valid non-negative number"
                });

            }


            if (
                !Number.isFinite(numericNewOrder) ||
                numericNewOrder < 0
            ) {

                return res.status(400).json({
                    success: false,
                    message:
                        "New order quantity must be a valid non-negative number"
                });

            }


            /*
            ------------------------------------------
            FIND PRODUCT
            ------------------------------------------
            */

            const product =
                await Product.findById(req.params.id);


            if (!product) {

                return res.status(404).json({
                    success: false,
                    message: "Product not found"
                });

            }


            /*
            ------------------------------------------
            TODAY
            ------------------------------------------
            */

            const today =
                getTodayDate();


            /*
            ------------------------------------------
            FIND HISTORICAL RECORDS
            ------------------------------------------

            Anything before today is LOCKED.
            ------------------------------------------
            */

            const historicalRecord =
                await Inventory.findOne({
                    product: product._id,
                    date: { $lt: today }
                });


            /*
            ------------------------------------------
            PRODUCT NAME SECURITY
            ------------------------------------------

            If historical records exist, changing
            the Product name would also change how
            those old records are displayed.

            Therefore the historical name is locked.
            ------------------------------------------
            */

            if (
                historicalRecord &&
                product.name !== productName
            ) {

                return res.status(403).json({
                    success: false,
                    message:
                        "Product name is locked because this product has historical inventory records."
                });

            }


            /*
            ------------------------------------------
            CHECK DUPLICATE NAME
            ------------------------------------------
            */

            const existing =
                await Product.findOne({
                    name: productName,
                    _id: {
                        $ne: product._id
                    }
                });


            if (existing) {

                return res.status(409).json({
                    success: false,
                    message:
                        " This product has already exist"
                });

            }


            /*
            ------------------------------------------
            UPDATE PRODUCT PRICE
            ------------------------------------------

            Historical inventory keeps its own
            stored price, so old values remain safe.
            ------------------------------------------
            */

            product.price =
                numericPrice;


            /*
            Only change the name if it is allowed.
            */

            if (!historicalRecord) {

                product.name =
                    productName;

            }


            await product.save();


            /*
            ------------------------------------------
            DELETE TODAY'S INVENTORY ONLY
            ------------------------------------------

            IMPORTANT:

            We NEVER touch records before today.
            ------------------------------------------
            */

            await Inventory.deleteMany({
                product: product._id,
                date: today
            });


            /*
            ------------------------------------------
            CREATE TODAY'S REMAINING STOCK
            ------------------------------------------
            */

            if (numericRemaining > 0) {

                await Inventory.create({

                    type:
                        "remaining",

                    product:
                        product._id,

                    date:
                        today,

                    quantity:
                        numericRemaining,

                    price:
                        numericPrice,

                    totalValue:
                        numericRemaining *
                        numericPrice

                });

            }


            /*
            ------------------------------------------
            CREATE TODAY'S NEW ORDER
            ------------------------------------------
            */

            if (numericNewOrder > 0) {

                await Inventory.create({

                    type:
                        "new-order",

                    product:
                        product._id,

                    date:
                        today,

                    quantity:
                        numericNewOrder,

                    price:
                        numericPrice,

                    totalValue:
                        numericNewOrder *
                        numericPrice

                });

            }


            /*
            ------------------------------------------
            RESPONSE
            ------------------------------------------
            */

            res.json({

                success: true,

                message:
                    "Today's inventory updated successfully",

                product: {

                    id:
                        product._id,

                    name:
                        product.name,

                    price:
                        product.price,

                    remainingQuantity:
                        numericRemaining,

                    newOrderQuantity:
                        numericNewOrder

                }

            });


        } catch (error) {

            console.error(
                "Edit product error:",
                error.message
            );


            res.status(500).json({

                success: false,

                message:
                    "Failed to update today's inventory"

            });

        }

    }
);

/*
==================================================
DELETE TODAY'S INVENTORY ONLY
==================================================
*/

app.delete(
    "/api/products/:id",
    async (req, res) => {

        try {

            const product =
                await Product.findById(
                    req.params.id
                );


            if (!product) {

                return res.status(404).json({

                    success: false,

                    message:
                        "Product not found"

                });

            }


            const today =
                getTodayDate();


            /*
            ------------------------------------------
            DELETE TODAY'S INVENTORY ONLY
            ------------------------------------------
            */

            await Inventory.deleteMany({

                product:
                    product._id,

                date:
                    today

            });


            /*
            ------------------------------------------
            RESPONSE
            ------------------------------------------
            */

            res.json({

                success: true,

                message:
                    "Removed successfully from today's inventory"

            });


        } catch (error) {

            console.error(
                "Delete today's inventory error:",
                error.message
            );


            res.status(500).json({

                success: false,

                message:
                    "Failed to remove today's inventory"

            });

        }

    }
);
      
/*
==================================================
DAILY SALES REPORT
==================================================
*/

app.get(
    "/api/reports/daily/:date",
    async (req, res) => {

        try {

            const requestedDate =
                req.params.date;


            /*
            ------------------------------------------
            FIND PREVIOUS DAY
            ------------------------------------------
            */

            const currentDate =
                new Date(
                    `${requestedDate}T00:00:00`
                );

            currentDate.setDate(
                currentDate.getDate() - 1
            );


            const previousYear =
                currentDate.getFullYear();

            const previousMonth =
                String(
                    currentDate.getMonth() + 1
                ).padStart(2, "0");

            const previousDay =
                String(
                    currentDate.getDate()
                ).padStart(2, "0");


            const previousDate =
                `${previousYear}-${previousMonth}-${previousDay}`;


            /*
            ------------------------------------------
            GET PREVIOUS CLOSING STOCK
            ------------------------------------------
            */

            const previousInventory =
                await Inventory.find({
                    date: previousDate,
                    type: "remaining"
                }).populate(
                    "product",
                    "name price"
                );


            /*
            ------------------------------------------
            GET TODAY'S NEW ORDERS
            ------------------------------------------
            */

            const todayOrders =
                await Inventory.find({
                    date: requestedDate,
                    type: "new-order"
                }).populate(
                    "product",
                    "name price"
                );


            /*
            ------------------------------------------
            GET TODAY'S CLOSING STOCK
            ------------------------------------------
            */

            const todayRemaining =
                await Inventory.find({
                    date: requestedDate,
                    type: "remaining"
                }).populate(
                    "product",
                    "name price"
                );


            /*
            ------------------------------------------
            COMBINE PRODUCTS
            ------------------------------------------
            */

            const products = {};


            function createProduct(
                product
            ) {

                if (!product) return;


                const id =
                    String(product._id);


                if (!products[id]) {

                    products[id] = {

                        productId:
                            id,

                        product:
                            product.name,

                        opening:
                            0,

                        newOrder:
                            0,

                        closing:
                            0,

                        price:
                            Number(
                                product.price || 0
                            )

                    };

                }

            }


            /*
            ------------------------------------------
            PREVIOUS CLOSING = OPENING
            ------------------------------------------
            */

            previousInventory.forEach(
                item => {

                    createProduct(
                        item.product
                    );


                    if (!item.product)
                        return;


                    const id =
                        String(
                            item.product._id
                        );


                    products[id].opening +=
                        Number(
                            item.quantity || 0
                        );

                }
            );


            /*
            ------------------------------------------
            TODAY'S NEW ORDERS
            ------------------------------------------
            */

            todayOrders.forEach(
                item => {

                    createProduct(
                        item.product
                    );


                    if (!item.product)
                        return;


                    const id =
                        String(
                            item.product._id
                        );


                    products[id].newOrder +=
                        Number(
                            item.quantity || 0
                        );


                    /*
                       Use today's order price.
                    */

                    products[id].price =
                        Number(
                            item.price || 0
                        );

                }
            );


            /*
            ------------------------------------------
            TODAY'S CLOSING STOCK
            ------------------------------------------
            */

            todayRemaining.forEach(
                item => {

                    createProduct(
                        item.product
                    );


                    if (!item.product)
                        return;


                    const id =
                        String(
                            item.product._id
                        );


                    products[id].closing +=
                        Number(
                            item.quantity || 0
                        );

                }
            );


            /*
            ------------------------------------------
            CALCULATE SALES
            ------------------------------------------
            */

            const sales =
                Object.values(
                    products
                ).map(product => {

                    const available =
                        product.opening +
                        product.newOrder;


                    const sold =
                        available -
                        product.closing;


                    const total =
                        sold *
                        product.price;


                    return {

                        productId:
                            product.productId,

                        product:
                            product.product,

                        opening:
                            product.opening,

                        newOrder:
                            product.newOrder,

                        closing:
                            product.closing,

                        sold:
                            sold,

                        price:
                            product.price,

                        total:
                            total

                    };

                });


            /*
            ------------------------------------------
            TOTALS
            ------------------------------------------
            */

            const totalQuantity =
                sales.reduce(
                    (sum, item) =>
                        sum +
                        item.sold,
                    0
                );


            const totalSales =
                sales.reduce(
                    (sum, item) =>
                        sum +
                        item.total,
                    0
                );


            /*
            ------------------------------------------
            RESPONSE
            ------------------------------------------
            */

            res.json({

                success:
                    true,

                date:
                    requestedDate,

                previousDate:
                    previousDate,

                sales:
                    sales,

                totals: {

                    quantity:
                        totalQuantity,

                    value:
                        totalSales

                }

            });


        } catch (error) {

            console.error(
                "Daily sales report error:",
                error.message
            );


            res.status(500).json({

                success:
                    false,

                message:
                    "Failed to generate daily sales report"

            });

        }

    }
);

/*
==================================================
DAILY SALES REPORT
==================================================
*/

app.get(
    "/api/reports/daily-sales/:date",
    async (req, res) => {

        try {

            const requestedDate =
                req.params.date;

            /*
            ------------------------------------------
            GET SELECTED DAY
            ------------------------------------------
            */

            const currentRecords =
                await Inventory
                    .find({
                        date: requestedDate
                    })
                    .populate(
                        "product",
                        "name price"
                    );


            /*
            ------------------------------------------
            GET PREVIOUS DAY
            ------------------------------------------
            */

            const date =
                new Date(
                    `${requestedDate}T00:00:00`
                );

            date.setDate(
                date.getDate() - 1
            );

            const previousDate =
                date.toISOString()
                    .slice(0, 10);


            const previousRecords =
                await Inventory
                    .find({
                        date: previousDate,
                        type: "remaining"
                    })
                    .populate(
                        "product",
                        "name price"
                    );


            /*
            ------------------------------------------
            BUILD PRODUCT DATA
            ------------------------------------------
            */

            const products = {};


            /*
            PREVIOUS CLOSING STOCK
            = TODAY'S OPENING STOCK
            */

            previousRecords.forEach(
                item => {

                    if (!item.product)
                        return;

                    const id =
                        String(
                            item.product._id
                        );


                    if (!products[id]) {

                        products[id] = {

                            productId:
                                id,

                            product:
                                item.product.name,

                            opening:
                                0,

                            newOrder:
                                0,

                            closing:
                                0,

                            price:
                                Number(
                                    item.product.price
                                )

                        };

                    }


                    products[id].opening +=
                        Number(item.quantity);

                }
            );


            /*
            ------------------------------------------
            TODAY'S RECORDS
            ------------------------------------------
            */

            currentRecords.forEach(
                item => {

                    if (!item.product)
                        return;

                    const id =
                        String(
                            item.product._id
                        );


                    if (!products[id]) {

                        products[id] = {

                            productId:
                                id,

                            product:
                                item.product.name,

                            opening:
                                0,

                            newOrder:
                                0,

                            closing:
                                0,

                            price:
                                Number(
                                    item.product.price
                                )

                        };

                    }


                    /*
                    TODAY'S NEW ORDER
                    */

                    if (
                        item.type ===
                        "new-order"
                    ) {

                        products[id].newOrder +=
                            Number(
                                item.quantity
                            );

                        products[id].price =
                            Number(
                                item.price
                            );

                    }


                    /*
                    TODAY'S CLOSING STOCK
                    */

                    if (
                        item.type ===
                        "remaining"
                    ) {

                        products[id].closing +=
                            Number(
                                item.quantity
                            );

                    }

                }
            );


            /*
            ------------------------------------------
            CALCULATE SALES
            ------------------------------------------
            */

            const sales =
                Object.values(products)
                    .map(product => {

                        const sold =
                            product.opening +
                            product.newOrder -
                            product.closing;


                        /*
                        Prevent invalid negative
                        sales caused by incomplete
                        inventory records.
                        */

                        const quantitySold =
                            Math.max(
                                0,
                                sold
                            );


                        const total =
                            quantitySold *
                            product.price;


                        return {

                            productId:
                                product.productId,

                            product:
                                product.product,

                            opening:
                                product.opening,

                            newOrder:
                                product.newOrder,

                            closing:
                                product.closing,

                            quantitySold:
                                quantitySold,

                            price:
                                product.price,

                            total:
                                total

                        };

                    })
                    .filter(
                        product =>
                            product.quantitySold > 0
                    );


            /*
            ------------------------------------------
            TOTALS
            ------------------------------------------
            */

            const totalQuantity =
                sales.reduce(
                    (sum, item) =>
                        sum +
                        item.quantitySold,
                    0
                );


            const totalValue =
                sales.reduce(
                    (sum, item) =>
                        sum +
                        item.total,
                    0
                );


            /*
            ------------------------------------------
            RESPONSE
            ------------------------------------------
            */

            res.json({

                success: true,

                date:
                    requestedDate,

                previousDate:
                    previousDate,

                count:
                    sales.length,

                totalQuantity:
                    totalQuantity,

                totalValue:
                    totalValue,

                sales:
                    sales

            });


        } catch (error) {

            console.error(
                "Daily sales report error:",
                error.message
            );


            res.status(500).json({

                success: false,

                message:
                    "Failed to generate daily sales report"

            });

        }

    }
);


/*
==================================================
START SERVER
==================================================
*/

async function startServer() {

    await connectDatabase();


    app.listen(
        PORT,
        () => {

            console.log("");

            console.log(
                "================================"
            );

            console.log(
                "       bManager Backend"
            );

            console.log(
                "================================"
            );

            console.log(
                `Server running on port ${PORT}`
            );

            console.log(
                `http://localhost:${PORT}`
            );

            console.log(
                "Database: MongoDB Atlas ☁️"
            );

            console.log(
                "Inventory storage: MongoDB ACTIVE 💾"
            );

            console.log(
                "================================"
            );

            console.log("");

        }
    );

}


startServer();